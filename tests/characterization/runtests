#!/bin/bash

# Pin the generated IEC representation for representative Structured Text,
# Instruction List, and Sequential Function Chart inputs.

set -u

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)
IEC2IEC=${IEC2IEC:-"$PROJECT_ROOT/iec2iec"}
MATIEC_LIBDIR=${MATIEC_LIBDIR:-"$PROJECT_ROOT/lib"}
EXPECTED_FILE="$SCRIPT_DIR/expected.sha256"

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/matiec-characterization.XXXXXX") || exit 1
trap 'rm -rf "$TMP_ROOT"' EXIT

compute_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    return 1
  fi
}

if test ! -r "$EXPECTED_FILE"; then
  echo "FAILURE -> Missing characterization manifest: $EXPECTED_FILE"
  exit 1
fi

error=0
total=0
while read -r expected_hash source; do
  test -n "$expected_hash" || continue
  total=$((total + 1))
  case_name=$(basename "$source")
  output_file="$TMP_ROOT/$case_name.out"
  stderr_file="$TMP_ROOT/$case_name.err"

  if ! "$IEC2IEC" -f -l -p -I "$MATIEC_LIBDIR" "$PROJECT_ROOT/$source" \
       >"$output_file" 2>"$stderr_file"; then
    echo "[ERROR]    $source -> compiler failed"
    sed -n '1,12p' "$stderr_file"
    error=1
    continue
  fi

  if test -s "$stderr_file"; then
    echo "[ERROR]    $source -> compiler emitted an unexpected diagnostic"
    sed -n '1,12p' "$stderr_file"
    error=1
    continue
  fi

  actual_hash=$(compute_sha256 "$output_file") || {
    echo "FAILURE -> Neither sha256sum nor shasum is available"
    exit 1
  }

  if test "$actual_hash" = "$expected_hash"; then
    echo "[ O K ]    $source"
  else
    echo "[ERROR]    $source -> generated output changed"
    echo "           expected: $expected_hash"
    echo "           actual:   $actual_hash"
    error=1
  fi
done <"$EXPECTED_FILE"

echo
if test "$error" = 1; then
  echo "FAILURE -> Generated-output characterization changed ($total cases)."
else
  echo "SUCCESS -> All $total generated-output characterizations match!"
fi

exit "$error"
