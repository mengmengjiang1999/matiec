#!/bin/bash

# Verify that context-sensitive IEC keywords accepted as identifiers continue
# to parse in every supported declaration and use site.

set -u

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(cd "$SCRIPT_DIR/../../.." && pwd)
IEC2IEC=${IEC2IEC:-"$PROJECT_ROOT/iec2iec"}
MATIEC_LIBDIR=${MATIEC_LIBDIR:-"$PROJECT_ROOT/lib"}

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/matiec-identifiers.XXXXXX") || exit 1
trap 'rm -rf "$TMP_ROOT"' EXIT

error=0
total=0
shopt -s nullglob
templates=("$SCRIPT_DIR"/identifier_*.test)

if test "${#templates[@]}" -eq 0; then
  echo "FAILURE -> No identifier templates found!"
  exit 1
fi

for template in "${templates[@]}"; do
  template_name=$(basename "$template")
  identifiers=()

  while IFS= read -r declaration; do
    read -r -a fields <<<"$declaration"
    for ((index = 1; index < ${#fields[@]}; index++)); do
      identifier=${fields[$index]}
      if [[ $identifier != \#* ]]; then
        identifiers+=("$identifier")
      fi
    done
  done < <(grep '^#' "$template")

  if test "${#identifiers[@]}" -eq 0; then
    echo "[ERROR]    $template_name -> no enabled identifiers found"
    error=1
    continue
  fi

  template_errors=0
  for identifier in "${identifiers[@]}"; do
    case_name="${template_name%.test}-$identifier"
    input_file="$TMP_ROOT/$case_name.iec"
    stdout_file="$TMP_ROOT/$case_name.stdout"
    stderr_file="$TMP_ROOT/$case_name.stderr"
    sed "s/XXXX/$identifier/g" "$template" >"$input_file"

    (
      cd "$SCRIPT_DIR" || exit 1
      "$IEC2IEC" -y -I "$MATIEC_LIBDIR" "$input_file" >"$stdout_file" 2>"$stderr_file"
    )
    status=$?
    total=$((total + 1))

    if test "$status" != 0; then
      echo "[ERROR]    $case_name -> compiler returned $status"
      sed -n '1,8p' "$stderr_file"
      template_errors=$((template_errors + 1))
    elif test -s "$stderr_file"; then
      echo "[ERROR]    $case_name -> compiler emitted an unexpected diagnostic"
      sed -n '1,8p' "$stderr_file"
      template_errors=$((template_errors + 1))
    fi
  done

  if test "$template_errors" = 0; then
    echo "[ O K ]    $template_name (${#identifiers[@]} identifiers)"
  else
    echo "[ERROR]    $template_name -> $template_errors case(s) failed"
    error=1
  fi
done

echo
if test "$error" = 1; then
  echo "FAILURE -> Identifier syntax tests failed ($total cases)."
else
  echo "SUCCESS -> All $total identifier syntax cases passed!"
fi

exit "$error"
