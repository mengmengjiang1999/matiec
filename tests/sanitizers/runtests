#!/bin/bash

# Build and run the regression suite under one compiler sanitizer without
# modifying the developer's configured source tree.

set -eu

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)
SANITIZER=${1:-}
JOBS=${JOBS:-2}

case "$SANITIZER" in
  address|undefined) ;;
  *)
    echo "usage: $0 {address|undefined}" >&2
    exit 2
    ;;
esac

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/matiec-$SANITIZER.XXXXXX") || exit 1
SOURCE_COPY="$TMP_ROOT/source"

cleanup() {
  status=$?
  trap - EXIT
  if test "$status" != 0; then
    for log in "$SOURCE_COPY/test-suite.log" \
               "$SOURCE_COPY/compiler/test-suite.log"; do
      if test -r "$log"; then
        echo
        echo "Sanitizer test log: ${log#"$SOURCE_COPY/"}"
        sed -n '1,240p' "$log"
      fi
    done
  fi
  rm -rf "$TMP_ROOT"
  exit "$status"
}
trap cleanup EXIT

mkdir -p "$SOURCE_COPY"
cp -R "$PROJECT_ROOT/." "$SOURCE_COPY"
find "$SOURCE_COPY" -type f \( -name '*.o' -o -name '*.a' -o -name '*.Po' \) -delete
rm -f "$SOURCE_COPY/iec2c" "$SOURCE_COPY/iec2iec"
rm -f "$SOURCE_COPY/stage1_2/iec_flex.cc" \
  "$SOURCE_COPY/stage1_2/iec_bison.cc" \
  "$SOURCE_COPY/stage1_2/iec_bison.hh"

SANITIZER_FLAGS="-g -O1 -fno-omit-frame-pointer -fsanitize=$SANITIZER"

cd "$SOURCE_COPY"
autoreconf -fi
CC=${CC:-cc} CXX=${CXX:-c++} \
  CFLAGS="$SANITIZER_FLAGS" \
  CXXFLAGS="$SANITIZER_FLAGS" \
  LDFLAGS="-fsanitize=$SANITIZER" \
  ./configure
make -j"$JOBS"

if test "$SANITIZER" = address; then
  case "$(uname -s)" in
    Darwin) DEFAULT_ASAN_OPTIONS=detect_leaks=0:halt_on_error=1 ;;
    *) DEFAULT_ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 ;;
  esac
  ASAN_OPTIONS=${ASAN_OPTIONS:-$DEFAULT_ASAN_OPTIONS} make check
else
  UBSAN_OPTIONS=${UBSAN_OPTIONS:-halt_on_error=1:print_stacktrace=1} make check
fi
