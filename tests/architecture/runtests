#!/bin/sh
set -eu

source_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)

require_text() {
  file=$1
  text=$2
  if ! grep -F "$text" "$source_root/$file" >/dev/null; then
    echo "$file: missing reentrancy invariant: $text" >&2
    exit 1
  fi
}

reject_text() {
  file=$1
  text=$2
  if grep -F "$text" "$source_root/$file" >/dev/null; then
    echo "$file: forbidden reentrancy fallback remains: $text" >&2
    exit 1
  fi
}

require_text stage1_2/iec_bison.yy "%define api.pure full"
require_text stage1_2/iec_bison.yy "%parse-param { matiec::ParserState &parser_state }"
require_text stage1_2/iec_bison.yy "%parse-param { void *scanner }"
require_text stage1_2/iec_flex.ll "%option reentrant"
require_text stage1_2/iec_flex.ll "matiec::ParserState &parser_state"
require_text config/verify_generated_frontend.pl "reject_process_termination"
require_text stage1_2/stage1_2.cc "get_identifier_token(matiec::ParserState &parser_state"
require_text stage1_2/iec_flex.ll "int GetNextChar(matiec::ParserState &parser_state"
reject_text compiler/parser_state.hh "ActiveParserStateScope"
reject_text compiler/parser_state.hh "active_parser_state"
reject_text compiler/parser_state.cc "current_parser_state"
reject_text stage1_2/iec_flex.ll "thread_local"
reject_text stage1_2/iec_bison.yy "thread_local"
reject_text config/verify_generated_frontend.pl "thread_local"
require_text README.md "The frontend reentrancy architecture track is complete."

echo "Reentrancy architecture audit passed."
