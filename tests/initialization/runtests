#!/bin/bash

# Test the datatype checking of the initial values of structured and array variables.
#
#   ok_*.st    --> must be accepted by the compiler.
#   bad_*.st   --> must be rejected by the compiler, with an error message.
#                  Aborting with an 'Internal compiler error' is considered a failure,
#                  as is generating C code for an invalid initial value!
#   xfail_*.st --> valid code that the compiler is known not to handle (yet).
#                  Reported as [XFAIL], and as [XPASS] once it starts working,
#                  in which case it should be renamed to ok_*.st.

set -u

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)
IEC2C=${IEC2C:-"$PROJECT_ROOT/iec2c"}
MATIEC_LIBDIR=${MATIEC_LIBDIR:-"$PROJECT_ROOT/lib"}

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/matiec-initialization.XXXXXX") || exit 1
trap 'rm -rf "$TMP_ROOT"' EXIT

# assume no error to start with...
error=0

shopt -s nullglob
test_files=("$SCRIPT_DIR"/ok_*.st "$SCRIPT_DIR"/bad_*.st "$SCRIPT_DIR"/xfail_*.st)
if test "${#test_files[@]}" -eq 0; then
  echo "FAILURE -> No initialization tests found!"
  exit 1
fi

for ff in "${test_files[@]}"
do
  test_name=$(basename "$ff")
  case_dir="$TMP_ROOT/${test_name%.st}"
  stdout_file="$case_dir/stdout"
  stderr_file="$case_dir/stderr"
  output_dir="$case_dir/output"
  mkdir -p "$output_dir"

  "$IEC2C" -f -l -p -I "$MATIEC_LIBDIR" -T "$output_dir" "$ff" >"$stdout_file" 2>"$stderr_file"
  status=$?

  case $test_name in
    xfail_*)
      if test $status = 0
        then echo "[XPASS]    $test_name -> now accepted, please rename it to ok_${test_name#xfail_}"; error=1
        else echo "[XFAIL]    $test_name -> known failure"
      fi
      continue
      ;;
    bad_*) expected_status=1 ;;
    *)     expected_status=0 ;;
  esac

  if grep -q "Internal compiler error" "$stderr_file"
    then echo "[ERROR]    $test_name -> internal compiler error"; error=1
  elif test "$expected_status" = 0 && test "$status" != 0
    then
      echo "[ERROR]    $test_name -> should have been accepted"
      sed -n '1,20p' "$stderr_file"
      error=1
  elif test "$expected_status" = 1 && test "$status" = 0
    then echo "[ERROR]    $test_name -> should have been rejected"; error=1
  elif test "$expected_status" = 1 && find "$output_dir" -type f -print -quit | grep -q .
    then echo "[ERROR]    $test_name -> generated output for invalid input"; error=1
  else echo "[ O K ]    $test_name"
  fi
done

echo
if test $error = 1
  then echo "FAILURE -> At least one of the tests failed!"
  else echo "SUCCESS -> All tests passed!"
fi

exit $error
