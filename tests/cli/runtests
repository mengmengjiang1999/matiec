#!/bin/bash

# Exercise command-line validation and the two compiler frontends without
# leaving generated output in the source tree.

set -u

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_ROOT=$(cd "$SCRIPT_DIR/../.." && pwd)
IEC2C=${IEC2C:-"$PROJECT_ROOT/iec2c"}
IEC2IEC=${IEC2IEC:-"$PROJECT_ROOT/iec2iec"}
MATIEC_LIBDIR=${MATIEC_LIBDIR:-"$PROJECT_ROOT/lib"}
CC=${CC:-cc}
read -r -a CC_COMMAND <<<"$CC"
INPUT_FILE="$PROJECT_ROOT/tests/initialization/ok_array_scalar.st"

TMP_ROOT=$(mktemp -d "${TMPDIR:-/tmp}/matiec-cli.XXXXXX") || exit 1
trap 'rm -rf "$TMP_ROOT"' EXIT

error=0

expect_failure() {
  test_name=$1
  expected_message=$2
  shift 2

  stdout_file="$TMP_ROOT/$test_name.stdout"
  stderr_file="$TMP_ROOT/$test_name.stderr"
  "$@" >"$stdout_file" 2>"$stderr_file"
  status=$?

  if test $status = 0; then
    echo "[ERROR]    $test_name -> command unexpectedly succeeded"
    error=1
  elif ! grep -q "$expected_message" "$stderr_file"; then
    echo "[ERROR]    $test_name -> expected diagnostic was not emitted"
    error=1
  else
    echo "[ O K ]    $test_name"
  fi
}

expect_failure missing-input "Missing input file" \
  "$IEC2C" -I "$MATIEC_LIBDIR"
expect_failure multiple-inputs "Too many input files" \
  "$IEC2C" -I "$MATIEC_LIBDIR" "$INPUT_FILE" "$INPUT_FILE"
expect_failure empty-include-directory "Option -I requires a non-empty directory" \
  "$IEC2C" -I "" "$INPUT_FILE"
expect_failure empty-target-directory "Option -T requires a non-empty directory" \
  "$IEC2C" -T "" "$INPUT_FILE"
expect_failure output-open-failure "Cannot open POUS.c for write access" \
  "$IEC2C" -f -l -p -I "$MATIEC_LIBDIR" \
  -T "$TMP_ROOT/missing/child" "$INPUT_FILE"
expect_failure invalid-language-profile "Unknown language profile" \
  "$IEC2C" --std=iec61131-3:2025 "$INPUT_FILE"
expect_failure missing-language-profile "Option --std requires an operand" \
  "$IEC2C" --std

for frontend in "$IEC2C" "$IEC2IEC"; do
  frontend_name=$(basename "$frontend")
  if "$frontend" -h >"$TMP_ROOT/$frontend_name.help" 2>&1 \
     && grep -q "iec61131-3:2025-experimental" "$TMP_ROOT/$frontend_name.help" \
     && grep -q "not a complete or certified" "$TMP_ROOT/$frontend_name.help"; then
    echo "[ O K ]    $frontend_name-profile-help"
  else
    echo "[ERROR]    $frontend_name-profile-help -> experimental disclaimer missing"
    error=1
  fi
done

compare_profiles() {
  test_name=$1
  source_file=$2
  shift 2
  omitted_output="$TMP_ROOT/$test_name.omitted"
  legacy_output="$TMP_ROOT/$test_name.legacy"
  experimental_output="$TMP_ROOT/$test_name.experimental"

  if "$IEC2IEC" "$@" -f -l -p -I "$MATIEC_LIBDIR" "$source_file" \
       >"$omitted_output" 2>"$TMP_ROOT/$test_name.omitted.err" \
     && "$IEC2IEC" "$@" --std=legacy -f -l -p -I "$MATIEC_LIBDIR" "$source_file" \
       >"$legacy_output" 2>"$TMP_ROOT/$test_name.legacy.err" \
     && "$IEC2IEC" "$@" --std=iec61131-3:2025-experimental \
       -f -l -p -I "$MATIEC_LIBDIR" "$source_file" \
       >"$experimental_output" 2>"$TMP_ROOT/$test_name.experimental.err" \
     && cmp -s "$omitted_output" "$legacy_output" \
     && cmp -s "$legacy_output" "$experimental_output"; then
    echo "[ O K ]    $test_name-profile-equivalence"
  else
    echo "[ERROR]    $test_name-profile-equivalence -> acceptance or output differs"
    for mode in omitted legacy experimental; do
      sed -n '1,8p' "$TMP_ROOT/$test_name.$mode.err"
    done
    error=1
  fi
}

compare_profiles structured-text "$INPUT_FILE"
compare_profiles instruction-list "$PROJECT_ROOT/tests/characterization/instruction_list.il"
compare_profiles sfc "$PROJECT_ROOT/tests/syntax/sfc/sfc.txt"
compare_profiles configuration "$PROJECT_ROOT/tests/initialization/ok_array_scalar.st"
compare_profiles reference "$SCRIPT_DIR/profile-fixtures/reference.st" -r

UTF8_INPUT="$SCRIPT_DIR/profile-fixtures/utf8.st"
UTF8_GENERATED="$TMP_ROOT/utf8-generated"
mkdir -p "$UTF8_GENERATED"
if "$IEC2C" --std=iec61131-3:2025-experimental -f -l -p \
     -I "$MATIEC_LIBDIR" -T "$UTF8_GENERATED" "$UTF8_INPUT" \
     >"$TMP_ROOT/utf8.stdout" 2>"$TMP_ROOT/utf8.stderr" \
   && grep -q '\\xE4\\xB8\\xAD\\xE6\\x96\\x87\\xF0\\x9F\\x9A\\x80' \
        "$UTF8_GENERATED/POUS.c" \
   && "${CC_COMMAND[@]}" -std=c99 -I "$MATIEC_LIBDIR/C" -I "$UTF8_GENERATED" \
        -include "$UTF8_GENERATED/POUS.h" \
        -c "$UTF8_GENERATED/POUS.c" -o "$UTF8_GENERATED/POUS.o"; then
  echo "[ O K ]    experimental-utf8-literal"
else
  echo "[ERROR]    experimental-utf8-literal -> UTF-8 literal was not emitted as stable bytes"
  sed -n '1,12p' "$TMP_ROOT/utf8.stderr"
  error=1
fi

expect_failure legacy-utf8-literal "UTF-8 string literals require" \
  "$IEC2C" --std=legacy -f -l -p -I "$MATIEC_LIBDIR" "$UTF8_INPUT"

MALFORMED_UTF8="$TMP_ROOT/malformed-utf8.st"
printf 'PROGRAM BAD\nVAR S : STRING := '\''\344\270'\''; END_VAR\nEND_PROGRAM\n' \
  >"$MALFORMED_UTF8"
expect_failure malformed-utf8-source "Malformed UTF-8 source" \
  "$IEC2C" --std=iec61131-3:2025-experimental -f -l -p \
  -I "$MATIEC_LIBDIR" "$MALFORMED_UTF8"

UTF8_RUNTIME="$TMP_ROOT/utf8-runtime.c"
cat >"$UTF8_RUNTIME" <<'EOF'
#include <assert.h>
#include "iec_std_lib.h"
TIME __CURRENT_TIME = {0, 0};
int main(void) {
  STRING value = __STRING_LITERAL(7, "\xE4\xB8\xAD\xF0\x9F\x9A\x80");
  assert(value.len == 7);
  assert(value.body[0] == 0xE4 && value.body[6] == 0x80);
  return 0;
}
EOF
if "${CC_COMMAND[@]}" -std=c99 -I "$MATIEC_LIBDIR/C" "$UTF8_RUNTIME" \
     -o "$TMP_ROOT/utf8-runtime" && "$TMP_ROOT/utf8-runtime"; then
  echo "[ O K ]    utf8-runtime-byte-abi"
else
  echo "[ERROR]    utf8-runtime-byte-abi -> encoded-byte representation changed"
  error=1
fi

REFERENCE_NULL="$SCRIPT_DIR/profile-fixtures/reference-null.st"
REFERENCE_GENERATED="$TMP_ROOT/reference-generated"
mkdir -p "$REFERENCE_GENERATED"
if "$IEC2C" --std=iec61131-3:2025-experimental -r -f -l -p \
     -I "$MATIEC_LIBDIR" -T "$REFERENCE_GENERATED" "$REFERENCE_NULL" \
     >"$TMP_ROOT/reference-null.stdout" 2>"$TMP_ROOT/reference-null.stderr" \
   && grep -q 'NULL' "$REFERENCE_GENERATED/POUS.c" \
   && "${CC_COMMAND[@]}" -std=c99 -I "$MATIEC_LIBDIR/C" -I "$REFERENCE_GENERATED" \
        -include "$REFERENCE_GENERATED/POUS.h" \
        -c "$REFERENCE_GENERATED/POUS.c" -o "$REFERENCE_GENERATED/POUS.o"; then
  echo "[ O K ]    experimental-reference-null-initialization"
else
  echo "[ERROR]    experimental-reference-null-initialization -> reference output failed"
  sed -n '1,12p' "$TMP_ROOT/reference-null.stderr"
  error=1
fi

expect_failure legacy-reference-initialization "REF_TO initialization is experimental" \
  "$IEC2C" --std=legacy -r -f -l -p -I "$MATIEC_LIBDIR" "$REFERENCE_NULL"
expect_failure incompatible-reference-assignment "Incompatible data types" \
  "$IEC2C" --std=iec61131-3:2025-experimental -r -f -l -p \
  -I "$MATIEC_LIBDIR" "$SCRIPT_DIR/profile-fixtures/reference-incompatible.st"
expect_failure standard-reference-broad-form "use -R option" \
  "$IEC2C" --std=iec61131-3:2025-experimental -r -y -I "$MATIEC_LIBDIR" \
  "$SCRIPT_DIR/profile-fixtures/reference-broad-extension.st"
if "$IEC2C" --std=iec61131-3:2025-experimental -R -y -I "$MATIEC_LIBDIR" \
     "$SCRIPT_DIR/profile-fixtures/reference-broad-extension.st" \
     >"$TMP_ROOT/reference-broad.stdout" 2>"$TMP_ROOT/reference-broad.stderr"; then
  echo "[ O K ]    matiec-reference-broad-extension"
else
  echo "[ERROR]    matiec-reference-broad-extension -> -R form was rejected"
  sed -n '1,12p' "$TMP_ROOT/reference-broad.stderr"
  error=1
fi
REFERENCE_LOCAL_GENERATED="$TMP_ROOT/reference-local-generated"
mkdir -p "$REFERENCE_LOCAL_GENERATED"
if "$IEC2C" --std=iec61131-3:2025-experimental -r -f -l -p \
     -I "$MATIEC_LIBDIR" -T "$REFERENCE_LOCAL_GENERATED" \
     "$SCRIPT_DIR/profile-fixtures/reference-local-lifetime.st" \
     >"$TMP_ROOT/reference-local.stdout" 2>"$TMP_ROOT/reference-local.stderr" \
   && "${CC_COMMAND[@]}" -std=c99 -I "$MATIEC_LIBDIR/C" \
        -I "$REFERENCE_LOCAL_GENERATED" -include "$REFERENCE_LOCAL_GENERATED/POUS.h" \
        -c "$REFERENCE_LOCAL_GENERATED/POUS.c" \
        -o "$REFERENCE_LOCAL_GENERATED/POUS.o"; then
  echo "[ O K ]    reference-local-lifetime"
else
  echo "[ERROR]    reference-local-lifetime -> local reference did not compile"
  sed -n '1,12p' "$TMP_ROOT/reference-local.stderr"
  error=1
fi

NAMESPACE_INPUT="$SCRIPT_DIR/profile-fixtures/namespace.st"
NAMESPACE_GENERATED="$TMP_ROOT/namespace-generated"
mkdir -p "$NAMESPACE_GENERATED"
if "$IEC2C" --std=iec61131-3:2025-experimental -f -l -p \
     -I "$MATIEC_LIBDIR" -T "$NAMESPACE_GENERATED" "$NAMESPACE_INPUT" \
     >"$TMP_ROOT/namespace.stdout" 2>"$TMP_ROOT/namespace.stderr" \
   && grep -q 'MATIECNS7FACTORY6MOTION5SPEED' "$NAMESPACE_GENERATED/POUS.h" \
   && grep -q 'MATIECNS7FACTORY6MOTION5CLAMP' "$NAMESPACE_GENERATED/POUS.c" \
   && "${CC_COMMAND[@]}" -std=c99 -I "$MATIEC_LIBDIR/C" -I "$NAMESPACE_GENERATED" \
        -include "$NAMESPACE_GENERATED/POUS.h" -c "$NAMESPACE_GENERATED/POUS.c" \
        -o "$NAMESPACE_GENERATED/POUS.o"; then
  echo "[ O K ]    experimental-namespace-output"
else
  echo "[ERROR]    experimental-namespace-output -> lowering or generated C failed"
  sed -n '1,12p' "$TMP_ROOT/namespace.stderr"
  error=1
fi

if "$IEC2C" --std=iec61131-3:2025-experimental -y -f -l -p \
     -I "$MATIEC_LIBDIR" "$SCRIPT_DIR/profile-fixtures/namespace-using.st" \
     >"$TMP_ROOT/namespace-using.stdout" 2>"$TMP_ROOT/namespace-using.stderr"; then
  echo "[ O K ]    experimental-namespace-using"
else
  echo "[ERROR]    experimental-namespace-using -> imported lookup failed"
  sed -n '1,12p' "$TMP_ROOT/namespace-using.stderr"
  error=1
fi

expect_failure namespace-ambiguity "Ambiguous namespace lookup" \
  "$IEC2C" --std=iec61131-3:2025-experimental -y -f -l -p \
  -I "$MATIEC_LIBDIR" "$SCRIPT_DIR/profile-fixtures/namespace-ambiguous.st"
expect_failure namespace-visibility "Namespace declaration is inaccessible" \
  "$IEC2C" --std=iec61131-3:2025-experimental -y -f -l -p \
  -I "$MATIEC_LIBDIR" "$SCRIPT_DIR/profile-fixtures/namespace-internal.st"
expect_failure legacy-namespace "unknown syntax error" \
  "$IEC2C" --std=legacy -y -f -l -p -I "$MATIEC_LIBDIR" "$NAMESPACE_INPUT"

generated_dir="$TMP_ROOT/generated"
mkdir -p "$generated_dir"
if "$IEC2C" --std=legacy -f -l -p -I "$MATIEC_LIBDIR" -T "$generated_dir" "$INPUT_FILE" \
     >"$TMP_ROOT/iec2c.stdout" 2>"$TMP_ROOT/iec2c.stderr" \
   && test -s "$generated_dir/POUS.c" \
   && test -s "$generated_dir/POUS.h"; then
  echo "[ O K ]    iec2c-smoke"
else
  echo "[ERROR]    iec2c-smoke -> C output was not generated"
  error=1
fi

generated_c_error=0
for source in config.c resource1.c; do
  object_file="$generated_dir/${source%.c}.o"
  if ! "${CC_COMMAND[@]}" -std=c99 -I "$MATIEC_LIBDIR/C" -I "$generated_dir" \
       -c "$generated_dir/$source" -o "$object_file" \
       >"$TMP_ROOT/$source.stdout" 2>"$TMP_ROOT/$source.stderr" \
     || test ! -s "$object_file"; then
    echo "[ERROR]    generated-c-$source -> generated C did not compile"
    sed -n '1,12p' "$TMP_ROOT/$source.stderr"
    generated_c_error=1
  fi
done

if test "$generated_c_error" = 0; then
  echo "[ O K ]    generated-c-compile"
else
  error=1
fi

if "$IEC2IEC" --std=iec61131-3:2025-experimental -f -l -p -I "$MATIEC_LIBDIR" "$INPUT_FILE" \
     >"$TMP_ROOT/iec2iec.stdout" 2>"$TMP_ROOT/iec2iec.stderr" \
   && test -s "$TMP_ROOT/iec2iec.stdout"; then
  echo "[ O K ]    iec2iec-smoke"
else
  echo "[ERROR]    iec2iec-smoke -> IEC output was not generated"
  error=1
fi

if test -e /dev/full; then
  "$IEC2IEC" -f -l -p -I "$MATIEC_LIBDIR" "$INPUT_FILE" \
    >/dev/full 2>"$TMP_ROOT/write-failure.stderr"
  status=$?
  if test $status != 0 && grep -q "Error writing generated output" "$TMP_ROOT/write-failure.stderr"; then
    echo "[ O K ]    output-write-failure"
  else
    echo "[ERROR]    output-write-failure -> write error was not reported"
    error=1
  fi
else
  echo "[SKIP]     output-write-failure -> /dev/full is unavailable"
fi

echo
if test $error = 1; then
  echo "FAILURE -> At least one CLI test failed!"
else
  echo "SUCCESS -> All CLI tests passed!"
fi

exit $error
